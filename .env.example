# Create a reusable, ephemeral Tailscale auth key with the minimum tags needed.
TAILSCALE_AUTHKEY=tskey-auth-replace-me
TAILSCALE_HOSTNAME=shadow-lab
TAILSCALE_IMAGE_TAG=v1.84.3

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret
SEARXNG_BASE_URL=http://shadow-lab:8081/
SEARXNG_IMAGE_TAG=latest

CONTROL_PANEL_URL=http://shadow-lab:8080/
TAILSCALE_CHECK_INTERVAL=15
LOG_TAIL_MAX=2000
SOCKET_PROXY_IMAGE_TAG=0.3.0

# --- Scanner platform ---
# Database (SQLite by default; use postgresql://... for multi-host)
DATABASE_URL=sqlite:///data/shadow-lab/shadow.db
# Redis for job queue and progress pub/sub
REDIS_URL=redis://redis:6379/0
# Worker identifier (set to worker-asus or worker-macbook per host)
WORKER_ID=worker-asus
# Scanner safety defaults (conservative)
SCANNER_MAX_CONCURRENCY=8
SCANNER_RPS=5
SCANNER_CONNECT_TIMEOUT=5
SCANNER_COMMAND_TIMEOUT=300
SCANNER_SCAN_TIMEOUT=3600
SCANNER_MAX_HOSTS=65536
# The Docker network / interface used for outbound scanning traffic.
# Workers are attached to this network; scanning traffic must NOT route
# through the Tailscale management interface.
SCANNER_EGRESS_NETWORK=egress
# Evidence retention in days
EVIDENCE_RETENTION_DAYS=90
# Enable IPv6 scope support
ENABLE_IPV6=true

# --- Remote SSH worker (ASUS / medusa) ---
# The control panel runs scanner tools on the remote host via Tailscale SSH.
# Requires Tailscale SSH enabled in the tailnet ACLs.
WORKER_REMOTE_HOST=medusa
# SSH user (leave blank to use the default Tailscale SSH user)
WORKER_REMOTE_USER=


# --- Hermes data directory ---
# Where Hermes config/keys/sessions/skills/memories are persisted on the host.
# Defaults to ./data/hermes if left blank.
HERMES_DATA_DIR=./data/hermes
# --- Hermes dashboard (served on the tailnet at http://<tailscale-ip-or-name>:9119) ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Random secret so dashboard sessions survive container restarts. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# --- Hermes OpenAI-compatible API server (served on the tailnet at http://<tailscale-ip-or-name>:8642) ---
API_SERVER_ENABLED=true
# Generate with: openssl rand -hex 32
API_SERVER_KEY=
API_SERVER_CORS_ORIGINS=*
